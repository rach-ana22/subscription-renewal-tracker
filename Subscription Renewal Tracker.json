    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "output = []\n\nfor item in _items:\n    data = item[\"json\"]\n\n    # Use the full email text\n    text = data.get(\"text\", \"\")\n    text_lower = text.lower()\n\n    # -------------------------\n    # Detect service\n    # -------------------------\n    if \"netflix\" in text_lower:\n        service = \"Netflix\"\n    elif \"spotify\" in text_lower:\n        service = \"Spotify\"\n    elif \"canva\" in text_lower:\n        service = \"Canva\"\n    elif \"adobe\" in text_lower or \"creative cloud\" in text_lower:\n        service = \"Adobe Creative Cloud\"\n    elif \"youtube\" in text_lower or \"youtube premium\" in text_lower:\n        service = \"YouTube Premium\"\n    elif \"amazon\" in text_lower or \"prime\" in text_lower:\n        service = \"Amazon Prime\"\n    elif \"disney\" in text_lower or \"disney+\" in text_lower:\n        service = \"Disney+\"\n    elif \"microsoft\" in text_lower or \"office 365\" in text_lower:\n        service = \"Microsoft 365\"\n    elif \"chatgpt\" in text_lower or \"openai\" in text_lower:\n        service = \"ChatGPT\"\n    elif \"notion\" in text_lower:\n        service = \"Notion\"\n    else:\n        service = \"Unknown\"\n\n    # -------------------------\n    # Detect currency\n    # -------------------------\n    if \"₹\" in text:\n        currency = \"INR\"\n    elif \"$\" in text:\n        currency = \"USD\"\n    elif \"€\" in text:\n        currency = \"EUR\"\n    elif \"£\" in text:\n        currency = \"GBP\"\n    else:\n        currency = \"UNKNOWN\"\n\n    # -------------------------\n    # Extract amount\n    # -------------------------\n    amount = None\n\n    markers = [\n        \"amount: ₹\",\n        \"amount: $\",\n        \"amount: €\",\n        \"amount: £\",\n        \"amount is ₹\",\n        \"amount is $\",\n        \"amount is €\",\n        \"amount is £\",\n        \"charged ₹\",\n        \"charged $\",\n        \"charged €\",\n        \"charged £\"\n    ]\n\n    for marker in markers:\n        position = text_lower.find(marker)\n\n        if position != -1:\n            start = position + len(marker)\n            number = \"\"\n\n            while start < len(text):\n                char = text[start]\n\n                if char.isdigit() or char in \".,\": \n                    number += char\n                    start += 1\n                else:\n                    break\n\n            if number:\n                amount = float(number.replace(\",\", \"\"))\n                break\n\n    # -------------------------\n    # Extract renewal date\n    # -------------------------\n    renewal_date = None\n\n    date_markers = [\n        \"renewal date:\",\n        \"renew on \",\n        \"renewal on \",\n        \"charged on \"\n    ]\n\n    for marker in date_markers:\n        position = text_lower.find(marker)\n\n        if position != -1:\n            start = position + len(marker)\n            remaining = text[start:]\n\n            renewal_date = remaining.split(\"\\n\")[0].strip()\n            renewal_date = renewal_date.rstrip(\" .\")\n\n            break\n\n    # -------------------------\n    # Extract user's email\n    # -------------------------\n    to_data = data.get(\"to\", \"\")\n    user_email = \"\"\n\n    if isinstance(to_data, str):\n\n        # Example:\n        # Demo <demo@example.com>\n        if \"<\" in to_data and \">\" in to_data:\n            user_email = (\n                to_data.split(\"<\")[1]\n                .split(\">\")[0]\n                .strip()\n            )\n        else:\n            user_email = to_data.strip()\n\n    elif isinstance(to_data, dict):\n\n        values = to_data.get(\"value\", [])\n\n        if values and isinstance(values[0], dict):\n            user_email = values[0].get(\"address\", \"\").strip()\n\n    # -------------------------\n    # Create clean record\n    # -------------------------\n    output.append({\n        \"json\": {\n            \"service\": service,\n            \"amount\": amount,\n            \"currency\": currency,\n            \"renewal_date\": renewal_date,\n            \"source_email_id\": data.get(\"id\"),\n            \"user_email\": user_email\n        }\n    })\n\nreturn output"
      },
